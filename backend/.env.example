# ============================================================
# Copy thành .env khi chạy local. Trên Render KHÔNG dùng file này:
# khai báo các key tương ứng trong Dashboard > Environment
# (hoặc qua render.yaml ở root repo — secret để sync:false).
# KHÔNG commit file .env thật lên Git.
# ============================================================

# --- Bắt buộc ở production ---
# Render có thể tự sinh (generateValue) cho 2 key này.
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET_KEY=replace-with-another-long-random-string
FLASK_ENV=production

# --- Database: Neon Postgres ---
# Dùng POOLED connection string của Neon (host có "-pooler"), ví dụ:
# postgresql://<user>:<password>@ep-<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require
# Backend tự normalize sang postgresql+psycopg và ép sslmode=require kể cả
# khi dán chuỗi direct. Để trống khi chạy local -> tự dùng SQLite dev.db.
DATABASE_URL=

# --- CORS: domain FE trên Vercel + localhost khi dev, cách nhau bằng dấu phẩy ---
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# --- JWT (tuỳ chọn, mặc định access 30 phút / refresh 7 ngày) ---
# JWT_ACCESS_MINUTES=30
# JWT_REFRESH_DAYS=7

# --- Tài khoản admin đầu tiên (dùng bởi lệnh `flask seed`) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# --- AI chatbot (chỉ cần key của provider đang dùng) ---
AI_PROVIDER=gemini
AI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_DAILY_LIMIT=50

# --- Tuỳ chọn production ---
# Rate limit dùng chung cho nhiều worker gunicorn (mặc định memory://):
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
# Số worker gunicorn (Dockerfile đọc biến này, mặc định 2):
# WEB_CONCURRENCY=2
